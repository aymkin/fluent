{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "description": "Validate JSON and back up data files after modifications",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/validate-data.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "description": "Display learner stats and check for due reviews",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/session-start.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "description": "Record a prompt timestamp so session length can be measured",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/prompt-clock.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
